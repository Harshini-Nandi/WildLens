# WildBuddy Server Configuration
PORT=3001

# Ollama Local AI Runtime URL
# Default local instance is http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Open-weight Vision Model (e.g., gemma3, llava, moondream, minicpm-v)
OLLAMA_VISION_MODEL=gemma3

# Open-weight Text Model for Outdoor Challenges (e.g., gemma3, llama3.2, mistral)
OLLAMA_TEXT_MODEL=gemma3

# Ollama timeout in milliseconds (default 60 seconds)
OLLAMA_TIMEOUT_MS=60000
